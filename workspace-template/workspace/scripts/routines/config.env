# Sourced by run_routine.sh. No secrets here.
# The coaching server's MCP name as Claude Code sees it: the prefix of its tools, without the
# trailing "__<tool>". A claude.ai connector named "Coaching" is mcp__claude_ai_Coaching.
COACHING_SERVER=mcp__claude_ai_Coaching
# Absolute path when cron's PATH does not find claude (e.g. $HOME/.local/bin/claude).
CLAUDE_BIN=claude
# Pin a model so a CLI update or an interactive /model change does not move the routines. Empty =
# the CLI default.
ROUTINE_MODEL=
# Seconds before a run is killed (needs coreutils timeout).
ROUTINE_TIMEOUT=2700
